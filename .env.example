# ===== 环境变量模板 =====
# 复制成 .env 后按需修改。.env 已在 .gitignore 里，不会被提交。

# 数据库：默认 SQLite，clone 下来不用装数据库就能跑
# 换成 PostgreSQL 示例：postgresql+psycopg://user:pass@localhost:5432/meditriage
APP_DATABASE_URL=sqlite:///./data/app.db

# 分诊生成模式：
#   rule  —— 不调用任何模型，零依赖（默认）
#   local —— 调用本机 Ollama，数据不出本机
#   api   —— 调用 OpenAI 兼容接口，需要填下面的 key
APP_TRIAGE_MODE=rule

# local 模式用
APP_OLLAMA_BASE_URL=http://localhost:11434
APP_OLLAMA_MODEL=qwen2.5:7b

# api 模式用（⚠️ 不要把自己的 key 写进这个文件再提交，.env 才是放 key 的地方）
APP_API_BASE_URL=https://api.deepseek.com
APP_API_KEY=
APP_API_MODEL=deepseek-chat

# 调试
APP_DEBUG=false
