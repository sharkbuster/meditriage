# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# ===== 运行时数据（不要提交生成的数据库）=====
data/*.db
data/*.db-wal
data/*.db-shm

# ===== 测试与缓存 =====
.pytest_cache/
.coverage
htmlcov/
pytest-*.txt
*.log

# pytest 的临时目录。
# 正常情况下它在系统 Temp 下，但如果环境变量被改过（或沙箱不允许写系统 Temp），
# pytest 会在项目根目录建 pytest-of-<用户名>/，里面全是临时数据库文件。
# 这些绝不能提交。
pytest-of-*/

# ===== 环境变量：含密钥，绝对不要提交 =====
.env
.env.local
*.local.yml

# ===== 编辑器 =====
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ===== Docker =====
*.pid
